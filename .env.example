# Seeker Environment Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=seeker_super_secure_jwt_secret_key_2026_production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: MongoDB Cloud Database (e.g. MongoDB Atlas free cluster)
# If left unset, Seeker automatically uses local JSON database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/seeker?retryWrites=true&w=majority
