# Kibou Environment Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=kibou_super_secure_jwt_secret_key_2026_production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Free AI LLM for Sukhi (High-Speed Llama 3.3 70B)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: MongoDB Cloud Database (e.g. MongoDB Atlas free cluster)
# If left unset, Kibou automatically uses local encrypted database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kibou?retryWrites=true&w=majority
